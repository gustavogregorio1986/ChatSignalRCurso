

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-lg rounded-3">

              <div class="card-header bg-primary text-white text-center">
                  <h4>Escolha sua Sala de chat</h4>
              </div>

              <div class="card-body">

                  <div class="mb-3">
                      <label for="usuario" class="form-label">Usuário:</label>
                      <input type="text" id="usuario" class="form-control" placeholder="Digite o nome" required/>
                  </div>

                    <div class="mb-3">
                        <label for="nomeSala" class="form-label">Usuário:</label>
                        <select id="nomeSala" type="text" class="form-control" required>
                            <option value="">Selecione uma sala</option>
                            <option value="Geral">Geral</option>
                            <option value="Esportes">Esportes</option>
                            <option value="Tecnologia">Tecnologia</option>
                            <option value="Música">Música</option>
                            <option value="Noticias">Noticias</option>
                            <option value="Jogos">Jogos</option>
                         </select>
                    </div>

                    <div class="d-flex justify-content-center">
                        <button id="entrarSala" class="btn btn-success w-50">Entrar na Sala</button>
                    </div>

              </div>

            </div>
        </div>
    </div>
</div>